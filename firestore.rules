rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Meetings collection
    // =========================================================================
    match /meetings/{meetingId} {

      // Any authenticated user can read a meeting (needed for Join Meeting).
      allow read: if request.auth != null;

      // Authenticated users can create meetings.
      // The hostUid in the document must match the authenticated user's UID.
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the host can update host-controlled fields.
      // Any authenticated user can increment participantCount (for joining).
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['participantCount']));

      // Only the host can delete their meeting.
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;
    }

    // =========================================================================
    // Default: deny everything else
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
