rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Meetings collection
    // =========================================================================
    match /meetings/{meetingId} {

      // Any authenticated user can read a meeting (needed for Join Meeting).
      allow read: if request.auth != null;

      // Authenticated users can create meetings.
      // The hostUid in the document must match the authenticated user's UID.
      allow create: if request.auth != null
                    && request.resource.data.hostUid == request.auth.uid;

      // Only the host can update host-controlled fields.
      // Any authenticated user can increment participantCount (for joining).
      // Any authenticated user can add an 'answer' for WebRTC signaling.
      allow update: if request.auth != null
                    && (resource.data.hostUid == request.auth.uid
                        || request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['participantCount'])
                        || request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['answer']));

      // Only the host can delete their meeting.
      allow delete: if request.auth != null
                    && resource.data.hostUid == request.auth.uid;

      // WebRTC Signaling: ICE candidates
      match /callerCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if request.auth != null;
      }
    }

    // =========================================================================
    // Default: deny everything else
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
